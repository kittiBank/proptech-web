# Base URL of the PropertyHub (NestJS) API, without a trailing slash.
# Leave unset to use the in-browser mock API (MSW).
# Inlined at build time: rebuild after changing it.
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Public origin of this site, without a trailing slash. Used for canonical URLs,
# Open Graph, sitemap.xml and JSON-LD. Inlined at build time.
# NEXT_PUBLIC_SITE_URL=https://www.propertyhub.example

# Planned maintenance (D10). Read at request time, so no rebuild is needed.
# MAINTENANCE_MODE=on answers every site page with the maintenance page and HTTP 503.
# MAINTENANCE_MODE=on
# MAINTENANCE_STARTS_AT=2026-11-29T02:00:00+07:00
# MAINTENANCE_ENDS_AT=2026-11-29T04:00:00+07:00

# Admin app (FE-20). ADMIN_HOST is read at request time: that host is served from /admin/*,
# and /admin is hidden on every other host. Unset = admin at /admin (local, previews).
# ADMIN_HOST=admin.propertyhub.example
# Link prefix inside the admin app. Inlined at build time; set it empty for the subdomain build.
# NEXT_PUBLIC_ADMIN_BASE_PATH=
# Environment label in the admin top bar (default: "Mock API", or "Production" with a real API).
# NEXT_PUBLIC_APP_ENV=Staging
