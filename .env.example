# Base URL of the PropertyHub (NestJS) API, without a trailing slash.
# Leave unset to use the in-browser mock API (MSW).
# Inlined at build time: rebuild after changing it.
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Public origin of this site, without a trailing slash. Used for canonical URLs,
# Open Graph, sitemap.xml and JSON-LD. Inlined at build time.
# NEXT_PUBLIC_SITE_URL=https://www.propertyhub.example

# Planned maintenance (D10). Read at request time, so no rebuild is needed.
# MAINTENANCE_MODE=on serves /maintenance with HTTP 503 for every page.
# MAINTENANCE_MODE=on
# MAINTENANCE_STARTS_AT=2026-11-29T02:00:00+07:00
# MAINTENANCE_ENDS_AT=2026-11-29T04:00:00+07:00
